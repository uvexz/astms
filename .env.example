# libSQL / Turso
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Better Auth (required for login and /dashboard; anonymous mailboxes do not use it)
BETTER_AUTH_URL=http://localhost:3000
# Production: >= 32 random bytes. Never commit the real value.
BETTER_AUTH_SECRET=
# Optional comma-separated extra trusted origins for OAuth callbacks.
BETTER_AUTH_TRUSTED_ORIGINS=

# Email + password login. Off by default; set to 1 or true to enable.
# The first sign-in with an unknown email automatically registers the account.
EMAIL_PASS_LOGIN=0

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SB.SB OIDC client
SB_OIDC_CLIENT_ID=
SB_OIDC_CLIENT_SECRET=
SB_OIDC_ISSUER=https://sb.sb/oidc
# Optional overrides; defaults to ${BETTER_AUTH_URL}/api/auth/callback/sb
SB_OIDC_REDIRECT_URI=
# Optional override; defaults to "openid profile offline_access"
SB_OIDC_SCOPES=

# ASTMS branding
SITE_NAME=ASTMS

# ASTMS mailbox
MAILBOX_DOMAIN=domain.name
MAILBOX_TTL_SECONDS=90
MAILBOX_POLL_INTERVAL_SECONDS=10

# Mailtrap Inbound
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
MAILTRAP_WEBHOOK_SIGNING_SECRET=

# Internal cleanup endpoint
CRON_SECRET=
